generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  company        String?
  freeLeadsUsed  Int      @default(0)
  totalFreeLeads Int      @default(50)
  purchasedLeads Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leadQueries LeadQuery[]
  leads       Lead[]
  orders      Order[]
  notifications EmailNotification[]
}

model LeadQuery {
  id          String   @id @default(cuid())
  userId      String
  prompt      String
  industry    String?
  location    String?
  title       String?
  companySize String?
  status      String   @default("pending") // pending, processing, completed, failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  leads Lead[]
  notifications EmailNotification[]
}

model Lead {
  id        String   @id @default(cuid())
  queryId   String
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  title     String?
  linkedin  String?
  website   String?
  location  String?
  industry  String?
  companySize String?
  revenue   String?
  score     Int?
  createdAt DateTime @default(now())

  query LeadQuery @relation(fields: [queryId], references: [id])
  user  User      @relation(fields: [userId], references: [id])
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  quantity   Int
  amount     Float
  currency   String   @default("USD")
  status     String   @default("pending") // pending, completed, failed
  paymentId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model EmailNotification {
  id         String   @id @default(cuid())
  userId     String
  queryId    String
  email      String
  sentAt     DateTime @default(now())
  status     String   @default("sent")

  user  User      @relation(fields: [userId], references: [id])
  query LeadQuery @relation(fields: [queryId], references: [id])
}
